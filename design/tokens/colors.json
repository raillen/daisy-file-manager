    { "name": "fg.accent", "role": "Texto de link/destaque", "dark": "#58a6ff", "light": "#0969da", "wired": "#ffe500", "cyberpunk": "#ff2a85", "retro": "#11379f" },
    { "name": "fg.success", "role": "Texto de sucesso", "dark": "#3fb950", "light": "#1a7f37", "wired": "#67f4ed", "cyberpunk": "#00f0ff", "retro": "#186d56" },
    { "name": "fg.attention", "role": "Texto de atenção", "dark": "#d29922", "light": "#9a6700", "wired": "#ffe500", "cyberpunk": "#ffd166", "retro": "#9e6a03" },
