    { "name": "border.muted", "role": "Borda suave (separadores)", "dark": "#21262d", "light": "#d8dee4", "wired": "#121b3e", "cyberpunk": "#2d144e", "retro": "#c8c4bc" },
    { "name": "border.focus", "role": "Borda de foco", "dark": "#58a6ff", "light": "#0969da", "wired": "#ffe500", "cyberpunk": "#ff2a85", "retro": "#11379f" }
  ]
