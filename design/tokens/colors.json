{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Paleta semântica canônica do daisy-file-manager. Cada tema mapeia nomes semânticos para hex truecolor. Consumida pelo TUI (src/core/theme) e pelo website (website/design/tokens).",
  "tokens": [
    { "name": "bg.default", "role": "Fundo principal da aplicação", "dark": "#0d1117", "light": "#ffffff", "wired": "#070913", "cyberpunk": "#0e071e", "retro": "#f1eee9" },
    { "name": "bg.muted", "role": "Fundo secundário (sidebar, cabeçalhos)", "dark": "#161b22", "light": "#f6f8fa", "wired": "#00126b", "cyberpunk": "#1c0d38", "retro": "#e4dfd6" },
    { "name": "bg.inset", "role": "Fundo rebaixado (inputs, campos de formulário)", "dark": "#010409", "light": "#f6f8fa", "wired": "#03050c", "cyberpunk": "#070310", "retro": "#ffffff" },
    { "name": "bg.overlay", "role": "Fundo de diálogos e menus flutuantes", "dark": "#161b22", "light": "#ffffff", "wired": "#091129", "cyberpunk": "#241047", "retro": "#ded9cf" },
    { "name": "bg.accent", "role": "Fundo de ênfase (seleção primária)", "dark": "#1f6feb", "light": "#0969da", "wired": "#ffe500", "cyberpunk": "#ff2a85", "retro": "#11379f" },
    { "name": "bg.accentMuted", "role": "Fundo de destaque suave", "dark": "#388bfd1a", "light": "#ddf4ff", "wired": "#ffe50026", "cyberpunk": "#ff2a8526", "retro": "#11379f1f" },
    { "name": "bg.successMuted", "role": "Fundo de sucesso", "dark": "#23863626", "light": "#dafbe1", "wired": "#67f4ed26", "cyberpunk": "#00f0ff26", "retro": "#21836a26" },
    { "name": "bg.attentionMuted", "role": "Fundo de atenção", "dark": "#9e6a0326", "light": "#fff8c5", "wired": "#ffe50026", "cyberpunk": "#ffd16626", "retro": "#ffe6344d" },
    { "name": "bg.dangerMuted", "role": "Fundo de perigo", "dark": "#f8514926", "light": "#ffebe9", "wired": "#ff406826", "cyberpunk": "#ff386026", "retro": "#db324526" },
    { "name": "bg.selectedRow", "role": "Linha selecionada na lista de arquivos", "dark": "#1f6feb33", "light": "#ddf4ff", "wired": "#0025c566", "cyberpunk": "#9d4edd44", "retro": "#11379f26" },
    { "name": "fg.default", "role": "Texto principal", "dark": "#e6edf3", "light": "#1f2328", "wired": "#f1f1ea", "cyberpunk": "#f5f0fa", "retro": "#15162b" },
